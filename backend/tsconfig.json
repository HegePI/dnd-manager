{
    "compilerOptions": {
        "target": "es2022", // Bun supports modern JavaScript
        "module": "esnext", // Use ES modules
        "moduleResolution": "bundler", // Or "node16"/"nodenext" for modern Node.js resolution
        "outDir": "./dist",
        "rootDir": "./", // To include both src and migrations in the output structure
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true, // If you import JSON files
        "sourceMap": true // Optional: good for debugging
        // "declaration": true, // Optional: if you're creating a library
    },
    "include": [
        "src/**/*.ts",
        "migrations/**/*.ts"
        // Add other TS file paths if necessary
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.spec.ts" // Example: exclude test files from main build
    ]
}
