{
    "folders": [
        {
            "name": "Root",
            "path": "."
        },
        {
            "name": "backend",
            "path": "backend"
        },
        {
            "name": "db-migration",
            "path": "db-migration"
        },
        {
            "name": "frontend",
            "path": "frontend"
        },
        {
            "name":"graphiql",
            "path":"graphiql"
        },
        {
            "name": "k8s",
            "path": "k8s"
        },
        {
            "name": "pg-graphql-postgres",
            "path": "pg-graphql-postgres"
        },
        {
            "name": "scripts",
            "path": "scripts"
        },
        {
            "name": "system-tests",
            "path": "system-tests"
        },
    ],
    "extensions": {
        "recommendations": [
            "aaron-bond.better-comments",
            "editorconfig.editorconfig",
            "usernamehw.errorlens",
            "github.vscode-pull-request-github",
            "GitHub.copilot",
            "github.vscode-github-actions",
            "google.geminicodeassist",
            "eamodio.gitlens"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start Minikube",
                "type": "shell",
                "command": "minikube start --addons ingress",
                "problemMatcher": []
            },
            {
                "label": "Start System with Skaffold",
                "type": "shell",
                "command": "skaffold run",
                "problemMatcher": [],
                "dependsOn": "Start Minikube"
            },
            {
                "label": "Start skaffold dev",
                "type": "shell",
                "command": "skaffold dev",
                "problemMatcher": [],
                "dependsOn": "Start Minikube"
            },
            {
                "label": "Wait for System to be Ready",
                "type": "shell",
                "command": "sleep 120", // Adjust the sleep duration as needed
                "problemMatcher": [],
                "dependsOn": "Start System with Skaffold"
            },
            {
                "label": "Run System Tests",
                "type": "shell",
                "command": "npx playwright test",
                "options": {
                    "cwd": "${workspaceFolder:system-tests}"
                },
                "dependsOn": "Wait for System to be Ready",
                "problemMatcher": []
            },
            {
                "label": "Update Dependencies in All Folders",
                "type": "shell",
                "command": "npm update",
                "options": {
                    "cwd": "${workspaceFolder:Root}"
                },
                "problemMatcher": [],
                "dependsOrder": "sequence",
                "dependsOn": [
                    {
                        "label": "Update Dependencies in Backend",
                        "type": "shell",
                        "command": "npm update",
                        "options": {
                            "cwd": "${workspaceFolder:backend}"
                        },
                        "problemMatcher": []
                    },
                    {
                        "label": "Update Dependencies in System Tests",
                        "type": "shell",
                        "command": "npm update",
                        "options": {
                            "cwd": "${workspaceFolder:system-tests}"
                        },
                        "problemMatcher": []
                    },
                    {
                        "label": "Update Dependencies in Frontend",
                        "type": "shell",
                        "command": "npm update",
                        "options": {
                            "cwd": "${workspaceFolder:frontend}"
                        },
                        "problemMatcher": []
                    }
                ]
            }
        ]
    }
}