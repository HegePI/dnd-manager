{
	"name": "frontend",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"generate": "graphql-codegen",
		"schema": "https://localhost:3000/rpc/graphql",
		"documents": "**/*.gql"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.1",
		"@eslint/compat": "^1.4.0",
		"@eslint/css": "^0.13.0",
		"@eslint/js": "^9.38.0",
		"@eslint/json": "^0.13.2",
		"@eslint/markdown": "^7.5.0",
		"@graphql-codegen/cli": "^6.1.0",
		"@graphql-codegen/typescript": "^5.0.5",
		"@graphql-codegen/typescript-operations": "^5.0.5",
		"@storybook/addon-a11y": "^9.1.15",
		"@storybook/addon-docs": "^9.1.15",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/addon-vitest": "^9.1.15",
		"@storybook/sveltekit": "^9.1.15",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.47.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.9.1",
		"@vitest/browser": "3.2.3",
		"@vitest/coverage-v8": "3.2.3",
		"chromatic": "^13.3.2",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-security": "^3.0.1",
		"eslint-plugin-storybook": "^9.1.15",
		"eslint-plugin-svelte": "^3.12.5",
		"globals": "^16.4.0",
		"graphql": "^16.12.0",
		"graphql-codegen-svelte-apollo": "^1.1.0",
		"jiti": "^2.6.1",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"storybook": "^9.1.15",
		"svelte": "^5.42.2",
		"svelte-check": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.2",
		"vite": "^6.4.1",
		"vitest": "^3.2.4"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-node": "^5.4.0"
	}
}
